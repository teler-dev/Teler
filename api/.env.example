PORT=7001
DATA_ROOT=/opt/teler/data
API_TOKEN=replace-with-read-token
SYNC_TOKEN=replace-with-write-token
ALLOWED_ORIGINS=https://teler-pi.vercel.app

# Neon pooled connection string. Keep this only on the Oracle server.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
AUTH_SESSION_DAYS=30
