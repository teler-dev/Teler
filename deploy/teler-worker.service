[Unit]
Description=TELER background analytics worker
Documentation=https://github.com/teler-dev/Teler
After=network-online.target teler-api.service
Wants=network-online.target

[Service]
Type=simple
User=teler
Group=teler
WorkingDirectory=/opt/teler/app/api
EnvironmentFile=/etc/teler/teler.env
ExecStart=/usr/bin/node index-worker.js
Restart=on-failure
RestartSec=5
MemoryMax=256M
CPUQuota=40%
StandardOutput=journal
StandardError=journal
SyslogIdentifier=teler-worker
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/teler/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target