# Base URL of the TELER API on the Oracle Cloud instance. No trailing slash.
# Fill in your instance's public IP with dashes: 130.61.12.34 -> 130-61-12-34
VITE_API_BASE=https://130-61-12-34.sslip.io

# Shared bearer token — must match API_TOKEN in the server's /etc/teler/teler.env
# NOTE: this is bundled into the client JS and is therefore readable by any
# visitor who opens devtools. It blocks drive-by access, not a determined user.
VITE_API_TOKEN=replace-with-the-token-from-the-server
