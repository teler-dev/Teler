# Server-side Vercel Function settings. Never prefix these with VITE_.
TELER_API_BASE=https://130-61-12-34.sslip.io
TELER_API_TOKEN=replace-with-api-token-from-oracle
TELER_DASHBOARD_USERNAME=replace-with-dashboard-username
TELER_DASHBOARD_PASSWORD_HASH=scrypt$replace-with-generated-value
TELER_SESSION_SECRET=replace-with-generated-value
OPENROUTER_API_KEY=replace-with-a-new-openrouter-key

# Optional local-only direct API URL for `npm run dev`. The local API must run
# without API_TOKEN. For the real cookie auth flow, use `vercel dev` instead.
# VITE_API_BASE=http://localhost:7001
